# Copy to .env and edit. .env is never committed.
# Host port Haxall is reachable on
HAXALL_PORT=8080
# Haxall database / project name (also the /api/<name>/ path)
HAXALL_DB_NAME=demo
# Superuser created the first time the database is initialised
HAXALL_SU_USERNAME=su
HAXALL_SU_PASSWORD=change-me
# Pinned source versions (commit SHAs or tags) so builds are repeatable
HAXALL_REF=b13ca10d36d6896f48af07476bb7a78de015c0b3
XETO_REF=deb813507b8255d2159db81c5caf9b0ef0ad102e
DEFS_REF=d042781e7031c125332920c9800e3d04e8f16cf7
FANTOM_REF=3602f0e58bd34e28c83267cad8ac6af997e480db

# --- optional (leave out unless you need them) ---
# Where the web app's dev server forwards /api calls. Default: http://localhost:<HAXALL_PORT>
# HAXALL_URL=http://localhost:8080
# Browser used by `make screenshots` (default: first Chrome, Brave, Edge or Chromium found)
# BROWSER_PATH=/Applications/Brave Browser.app/Contents/MacOS/Brave Browser
# `make screenshots` colour theme: light (default) or dark
# SHOT_THEME=light
